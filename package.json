{
  "name": "mortgage-compliance-glossary",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4327",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4327",
    "validate": "node scripts/symmetrize-related.mjs && node scripts/validate-terms.mjs && npm run check:autolink",
    "data": "python3 scripts/reference_data.py",
    "astro": "astro",
    "check:links": "node scripts/checks/check-links.mjs",
    "audit": "node scripts/audit/audit.cjs http://127.0.0.1:4327 audit",
    "audit:search": "node scripts/audit/heldout.cjs http://127.0.0.1:4327",
    "check:es": "python3 scripts/checks/bilingual_check.py",
    "check:autolink": "node --experimental-strip-types --no-warnings scripts/checks/check-autolink.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "astro": "^7.4.13",
    "fuse.js": "^7.5.0"
  }
}
