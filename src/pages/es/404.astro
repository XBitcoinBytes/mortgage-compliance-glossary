---
import Base from "../../layouts/Base.astro";
import { hrefFor, t } from "../../lib/i18n";
const ui = t("es");
---
<Base lang="es" title={ui.notFound} description={ui.notFound} path="/404">
  <div class="wrap" style="padding:2rem 0">
    <h1>{ui.notFound}</h1>
    <p><a href={hrefFor("es", "/terms")}>{ui.notFoundLink}</a></p>
  </div>
</Base>
