---
import Browse from "../../../components/Browse.astro";
import Base from "../../../layouts/Base.astro";
import { getTerms } from "../../../lib/content";
import { t } from "../../../lib/i18n";
const ui = t("es");
---
<Base lang="es" title={ui.termsIndex} description={ui.termsDek} path="/terms">
  <div class="wrap" style="padding-top:1.4rem">
    <p class="kicker">{ui.siteKicker}</p>
    <h1>{ui.termsIndex}</h1>
    <p class="dek">{ui.termsDek}</p>
    <Browse lang="es" terms={getTerms()} />
  </div>
</Base>
