---
import Browse from "../../components/Browse.astro";
import Base from "../../layouts/Base.astro";
import { categories } from "../../data/categories";
import { termsInCategory } from "../../lib/content";
import type { CategoryId } from "../../lib/types";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.id }, props: { category } }));
}

interface Props {
  category: (typeof categories)[number];
}
const { category } = Astro.props;
const terms = termsInCategory(category.id as CategoryId);
---
<Base lang="en" title={category.label} description={category.dek} path={`/categories/${category.id}`}>
  <div class="wrap" style="padding-top:1.4rem">
    <p class="kicker">Topic</p>
    <h1>{category.label}</h1>
    <p class="dek">{category.dek}</p>
    <Browse lang="en" terms={terms} lockedCategory={category.id} />
  </div>
</Base>
