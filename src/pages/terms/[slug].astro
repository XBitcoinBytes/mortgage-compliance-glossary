---
import TermArticle from "../../components/TermArticle.astro";
import Base from "../../layouts/Base.astro";
import { getTerms } from "../../lib/content";
import { t } from "../../lib/i18n";
import { metaDescription, termJsonLd } from "../../lib/seo";
import type { Term } from "../../lib/types";

export function getStaticPaths() {
  return getTerms().map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

interface Props {
  term: Term;
}
const { term } = Astro.props;
const ui = t("en");
const origin = (Astro.site ?? new URL("http://127.0.0.1:4327")).toString().replace(/\/$/, "");
const jsonLd = termJsonLd(term, "en", origin);
---
<Base lang="en" title={term.term} description={metaDescription(term.definition)} path={`/terms/${term.slug}`} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, "\u003c")} />
  <TermArticle lang="en" term={term} />
  <p class="wrap" style="color:var(--ink-soft); max-width:42rem">{ui.disclaimer}</p>
</Base>
