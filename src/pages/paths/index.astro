---
import Base from "../../layouts/Base.astro";
import { paths } from "../../lib/content";
import { hrefFor, t } from "../../lib/i18n";
const ui = t("en");
---
<Base lang="en" title={ui.pathsTitle} description={ui.pathsDek} path="/paths">
  <div class="wrap" style="padding:1.4rem 0 2rem">
    <p class="kicker">{ui.forPros}</p>
    <h1>{ui.pathsTitle}</h1>
    <p class="dek">{ui.pathsDek}</p>
    <ol class="path-list">
      {paths.map((path) => (
        <li>
          <a href={hrefFor("en", `/paths/${path.slug}`)}>
            <strong>{path.title}</strong>
            <span>{path.summary}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
