---
import type { Lang } from "../lib/types";
import { hrefFor, t } from "../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/fraunces/latin-600.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/source-serif-4/latin-400.css";
import "@fontsource/source-serif-4/latin-600.css";
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-sans-3/latin-700.css";
import fraunces700 from "@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url";
import sourceSerif400 from "@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url";
import sourceSans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import "../styles/global.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogType?: "website" | "article";
}

const { lang, title, description, path, ogType = "website" } = Astro.props;
// Implicit default only: Spanish pages and Borrower question entries open in
// Borrower view. An explicit header choice or ?view= still wins in the head script.
const defaultView = lang === "es" || path.startsWith("/terms/faq-") ? "borrower" : "professional";
const metaDescription = description.replace(/\s+/g, " ").trim();
const shortDescription = metaDescription.length > 160 ? `${metaDescription.slice(0, 159).trimEnd()}…` : metaDescription;
const ui = t(lang);
const origin = (Astro.site ?? new URL("http://127.0.0.1:4327")).toString().replace(/\/$/, "");
const canonicalPath = hrefFor(lang, path);
const canonical = new URL(canonicalPath, origin).toString();
const enUrl = new URL(hrefFor("en", path), origin).toString();
const esUrl = new URL(hrefFor("es", path), origin).toString();
const fullTitle = title === ui.siteName ? title : `${title} · ${ui.siteName}`;
---

<!doctype html>
<html lang={lang} data-view={defaultView} data-default-view={defaultView}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("mcg-theme");
          if (theme !== "light" && theme !== "dark") {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", theme);
          // mcg-view-pref is written only when the reader clicks Borrower or Professional.
          // The older mcg-view key was also written on every page load, so it is ignored.
          var view = localStorage.getItem("mcg-view-pref");
          // A shared link can carry ?view=borrower or ?view=professional.
          var shared = new URLSearchParams(location.search).get("view");
          if (shared === "borrower" || shared === "professional") view = shared;
          if (view !== "borrower" && view !== "professional") {
            view = document.documentElement.getAttribute("data-default-view") || "professional";
          }
          document.documentElement.setAttribute("data-view", view);
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href={fraunces700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSerif400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSans400} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={shortDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={shortDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={shortDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header lang={lang} path={path} defaultView={defaultView} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <dialog class="dialog" id="search-dialog" aria-labelledby="search-dialog-title">
      <div class="dialog-card">
        <div class="dialog-head">
          <h2 id="search-dialog-title">{ui.dialogTitle}</h2>
          <button type="button" class="icon-btn" id="search-close">{ui.close}</button>
        </div>
        <p id="search-help">{ui.dialogHelp}</p>
        <label class="sr-only" for="search-input">{ui.searchHint}</label>
        <input id="search-input" type="search" autocomplete="off" placeholder={ui.searchPlaceholder} />
        <div class="pills" id="search-cats"></div>
        <p id="search-live" class="sr-only" aria-live="polite"></p>
        <ul class="results" id="search-results" role="listbox"></ul>
      </div>
    </dialog>
    <script>
      import { initChrome } from "../scripts/chrome";
      initChrome();
    </script>
  </body>
</html>
