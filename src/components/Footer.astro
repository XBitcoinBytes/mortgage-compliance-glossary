---
import type { Lang } from "../lib/types";
import { hrefFor, t } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
---

<footer class="site-footer">
  <div class="wrap">
    <p><strong>{ui.disclaimerTitle}.</strong> {ui.disclaimer}</p>
    {lang === "es" && <p>{ui.spanishNote}</p>}
    <div class="footer-row">
      <a href={hrefFor(lang, "/about")}>{ui.navAbout}</a>
      <a href={hrefFor(lang, "/terms")}>{ui.navGlossary}</a>
      <a href={hrefFor(lang, "/regulations")}>{ui.navRegulations}</a>
      <a href={hrefFor(lang, "/paths")}>{ui.navPaths}</a>
      <a href={hrefFor(lang, "/figures")}>{lang === "es" ? "Cifras que cambian" : "Figures that change"}</a>
    </div>
  </div>
</footer>
