---
import type { Lang } from "../lib/types";
import { hrefFor, t } from "../lib/i18n";
import { LEC_URL } from "../data/lec-pointers";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === "es";
const lecLabel = ui.lecTool;
const footerParts = ui.lecFooter.split("{tool}");
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-credit">{ui.creditLine}</p>
    <p><strong>{ui.disclaimerTitle}.</strong> {ui.disclaimer}</p>
    {es && <p>{ui.spanishNote}</p>}
    <div class="footer-row">
      <a href={hrefFor(lang, "/about")}>{ui.navAbout}</a>
      <a href={hrefFor(lang, "/terms")}>{ui.navGlossary}</a>
      <a href={hrefFor(lang, "/regulations")}>{ui.navRegulations}</a>
      <a href={hrefFor(lang, "/paths")}>{ui.navPaths}</a>
      <a href={hrefFor(lang, "/figures")}>{ui.figuresTitle}</a>
      <a href={hrefFor(lang, "/contribute")}>{ui.navContribute}</a>
    </div>
    <p class="footer-lec">
      {footerParts[0]}<a href={LEC_URL}>{lecLabel}</a>{footerParts[1] ?? ""}
    </p>
    <div class="related-work">
      <h2>{ui.relatedWorkTitle}</h2>
      <ul>
        <li>
          <a href="https://mortgageeval.com">{ui.relatedEval}</a>
          <span>{ui.relatedEvalDek}</span>
        </li>
        <li>
          <a href={LEC_URL}>{ui.relatedClear}</a>
          <span>{ui.relatedClearDek}</span>
        </li>
        <li>
          <a href="https://shaun-barry-portfolio.vercel.app">{ui.relatedPortfolio}</a>
          <span>{ui.relatedPortfolioDek}</span>
        </li>
        <li>
          <a href="https://github.com/XBitcoinBytes">{ui.relatedGithub}</a>
          <span>{ui.relatedGithubDek}</span>
        </li>
      </ul>
    </div>
  </div>
</footer>
