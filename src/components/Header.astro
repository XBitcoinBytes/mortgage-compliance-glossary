---
import type { Lang } from "../lib/types";
import { hrefFor, t } from "../lib/i18n";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const ui = t(lang);
const enHref = hrefFor("en", path);
const esHref = hrefFor("es", path);
const items = [
  [ui.navGlossary, "/terms"],
  [ui.navRegulations, "/regulations"],
  [ui.navPaths, "/paths"],
  [ui.navAbout, "/about"],
  [ui.navContribute, "/contribute"],
];
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={hrefFor(lang, "/")}>
      <svg class="seal" viewBox="0 0 48 48" aria-hidden="true">
        <rect x="1.5" y="1.5" width="45" height="45" rx="8" fill="none" stroke="currentColor" stroke-width="2"></rect>
        <path d="M12 34V14h8.5c4.8 0 7.6 2.5 7.6 6.3 0 2.6-1.4 4.6-3.7 5.6L29 34h-5.2l-4.2-7.4H17V34H12zm5-11.2h3.2c2.2 0 3.5-1.1 3.5-2.8s-1.3-2.7-3.5-2.7H17v5.5zM31 34V14h5v20h-5z" fill="currentColor"></path>
      </svg>
      <span>
        <strong>{ui.siteName}</strong>
        <small>{ui.siteKicker}</small>
      </span>
    </a>
    <nav class="nav-main" aria-label={ui.navPrimary}>
      {
        items.map(([label, href]) => (
          <a href={hrefFor(lang, href)} aria-current={path === href ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <button type="button" class="search-launch" id="search-open" aria-haspopup="dialog">
        {ui.search} <kbd>/</kbd>
      </button>
      <div class="seg" role="group" aria-label={ui.viewLabel} data-view-toggle>
        <button type="button" data-view-set="borrower" aria-pressed="false">{ui.borrower}</button>
        <button type="button" data-view-set="professional" aria-pressed="true">{ui.professional}</button>
      </div>
      <div class="lang-toggle" role="group" aria-label={ui.language}>
        <a href={enHref} hreflang="en" aria-current={lang === "en" ? "true" : undefined} lang="en">EN</a>
        <a href={esHref} hreflang="es" aria-current={lang === "es" ? "true" : undefined} lang="es">ES</a>
      </div>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label={ui.themeToDark}>
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>
<span class="sr-only" id="theme-labels" data-dark={ui.themeToDark} data-light={ui.themeToLight}></span>
