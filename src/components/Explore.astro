---
import type { Lang } from "../lib/types";
import Base from "../layouts/Base.astro";
import { hrefFor } from "../lib/i18n";
import { exploreData } from "../lib/explore-data";
import { createExplorer, EXPLORE_UI } from "../lib/explore";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = EXPLORE_UI[lang];
const explorer = createExplorer(exploreData(lang));
// The top layer is rendered here so it paints with the page (no layout shift).
// Deeper layers are drawn by src/scripts/explore.ts from /explore-data/<lang>.json.
const top = explorer.screen(explorer.root, ui.start);
---

<Base lang={lang} title={ui.title} description={ui.dek} path="/explore">
  <section
    class="wrap explore"
    id="explorer"
    data-lang={lang}
    data-src={`/explore-data/${lang}.json`}
    data-term-base={hrefFor(lang, "/terms/")}
  >
    <h1>{ui.title}</h1>
    <p class="dek">{ui.dek}</p>
    <div class="x-panel" id="x-panel">
      <nav class="x-crumbs" aria-label={ui.youAreHere}>
        <ol><li><span aria-current="location">{top.crumb}</span></li></ol>
      </nav>
      <div class="x-screen" data-kind={top.kind}>
        <h2 id="x-h" tabindex="-1">{top.heading}</h2>
        <p class="x-prompt">{top.prompt}</p>
        <ul class="x-options">
          {
            top.options.map((option) => (
              <li>
                <a class="x-opt" href={`#/${option.id}`}>
                  <strong>{option.label}</strong>
                  {option.hint && <span>{option.hint}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" id="x-status"></p>
    <noscript><p class="x-note">{ui.noscript}</p></noscript>
    <p class="x-alt">
      {ui.otherWays} <a href={hrefFor(lang, "/terms")}>{ui.browseAll}</a> · <a href={hrefFor(lang, "/paths")}>{ui.allPaths}</a>
    </p>
  </section>
</Base>

<script>
  import "../scripts/explore";
</script>

<style is:global>
  .explore { padding: 1.4rem 0 2.5rem; }
  .explore > .dek { max-width: var(--measure); }
  .x-panel {
    min-height: 34rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--paper-2);
    padding: 1rem 1.1rem 1.3rem;
    margin-top: 1rem;
  }
  .x-crumbs ol { list-style: none; margin: 0 0 0.8rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.4rem; font-size: 0.92rem; color: var(--ink-soft); }
  .x-crumbs li + li::before { content: "›"; margin-right: 0.4rem; color: var(--ink-soft); }
  .x-crumbs a, .x-crumbs [aria-current] { color: inherit; display: inline-block; padding: 0.3rem 0; }
  .x-crumbs [aria-current] { color: var(--ink); font-weight: 600; }
  .x-kicker { margin: 0 0 0.2rem; color: var(--ink-soft); font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .x-screen h2 { font-family: var(--display); font-size: clamp(1.45rem, 3.2vw, 2rem); margin: 0 0 0.6rem; }
  .x-screen h2:focus { outline: none; }
  .x-screen h2:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .x-body { max-width: var(--measure); font-family: var(--serif); font-size: 1.08rem; line-height: 1.6; }
  .x-body p { margin: 0 0 0.8rem; }
  .x-example { border-left: 4px solid var(--accent); padding: 0.4rem 0 0.4rem 0.9rem; margin: 0 0 0.9rem; }
  .x-example .x-setting { font-family: var(--sans); font-weight: 600; font-size: 0.95rem; color: var(--ink-soft); }
  .x-tag { font-family: var(--sans); font-size: 0.88rem; color: var(--ink-soft); }
  .x-cites { list-style: none; padding: 0; margin: 0 0 0.9rem; font-family: var(--sans); font-size: 1rem; }
  .x-cites li + li { margin-top: 0.5rem; }
  .x-cites span { display: block; color: var(--ink-soft); font-size: 0.92rem; }
  .x-prompt { margin: 0.4rem 0 0.7rem; color: var(--ink-soft); font-weight: 600; }
  .x-options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.6rem;
  }
  .x-opt {
    display: block;
    height: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }
  .x-opt:hover { border-color: var(--accent); }
  .x-opt strong { display: block; color: var(--accent); font-size: 1.05rem; line-height: 1.3; }
  .x-opt strong::after { content: " →"; }
  .x-opt span { display: block; margin-top: 0.2rem; color: var(--ink-soft); font-size: 0.93rem; line-height: 1.4; }
  .x-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.1rem 0 0; }
  .x-actions .btn { min-height: 2.75rem; }
  .x-alt, .x-note { color: var(--ink-soft); margin-top: 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .x-screen.x-enter { animation: x-in 0.16s ease-out; }
    @keyframes x-in { from { opacity: 0.35; } to { opacity: 1; } }
  }
  @media (max-width: 560px) {
    .x-panel { padding: 0.85rem 0.8rem 1.1rem; border-radius: 0.8rem; }
  }
</style>
